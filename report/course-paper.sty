\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{course-paper}[2026/11/18 Single-column course paper]
% The public ICLR 2026 sample uses article, Times, small caps and a
% 5.5-inch measure. The course report retains A4 and an institutional cover.
\RequirePackage[T1]{fontenc}
\RequirePackage{times}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage[a4paper,textwidth=5.5in,textheight=9in,top=1in,headheight=14pt,headsep=15pt]{geometry}
\RequirePackage{graphicx,booktabs,tabularx,array,caption,microtype}
\RequirePackage{xcolor,eso-pic,fancyhdr,listings,titlesec,placeins}
\RequirePackage[authoryear,round]{natbib}
\RequirePackage{xurl}
\RequirePackage[unicode,hidelinks,bookmarksnumbered]{hyperref}

\graphicspath{{figures/}}
\setlength{\parindent}{0pt}
\setlength{\parskip}{.48em plus .12em}
\linespread{1.08}
\raggedbottom
\setlength{\emergencystretch}{1.4em}
\widowpenalty=10000
\clubpenalty=10000
\renewcommand{\topfraction}{.92}
\renewcommand{\bottomfraction}{.75}
\renewcommand{\textfraction}{.07}
\renewcommand{\floatpagefraction}{.72}
\setcounter{topnumber}{3}
\setcounter{totalnumber}{4}
\numberwithin{equation}{section}
\titleformat{\section}{\large\scshape}{\thesection}{.65em}{}
\titleformat{\subsection}{\normalsize\scshape}{\thesubsection}{.6em}{}
\titleformat{\subsubsection}{\normalsize\bfseries}{\thesubsubsection}{.55em}{}
\titlespacing*{\section}{0pt}{2ex plus .4ex minus .2ex}{1ex}
\titlespacing*{\subsection}{0pt}{1.65ex plus .2ex minus .15ex}{.62ex}
\titlespacing*{\subsubsection}{0pt}{1.4ex plus .2ex minus .1ex}{.4ex}
\captionsetup{font=small,labelfont=bf,format=hang,hypcap=false}
\definecolor{listingbg}{gray}{.965}
\definecolor{listingrule}{gray}{.77}
\lstdefinestyle{paper}{
  basicstyle=\ttfamily\small,frame=single,framesep=6pt,framerule=.4pt,
  rulecolor=\color{listingrule},backgroundcolor=\color{listingbg},
  commentstyle=\itshape,numbers=left,numberstyle=\tiny,numbersep=9pt,xleftmargin=1.9em,
  captionpos=t,columns=fullflexible,keepspaces=true,showstringspaces=false,
  breaklines=true,aboveskip=.7em,belowskip=.65em,tabsize=4
}
